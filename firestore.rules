rules_version = '2';

// 우리 반 학급 포털 – 보안 규칙
// 바꾸면 Firebase 콘솔 > Firestore Database > 규칙 탭에 다시 붙여 넣고 '게시' (또는 firebase deploy --only firestore:rules)
//
// 원칙
// - 모든 기기는 익명 로그인으로 고유 ID(uid)만 가짐 (이메일·구글 계정 없음)
// - 관리자 키·교사 비밀번호·학생 PIN은 해시만 저장하고, 그 문서는 누구도 읽지 못함
// - 비밀번호를 아는 기기만 자기 uid로 등록 문서(admins / teachers / members / screens)를 만들 수 있고,
//   그 등록 문서가 있어야 해당 역할로 읽고 쓸 수 있음
// - 학생은 자기 기록만 쓰고, 과제 '확인'·링크·공지는 교사만 씀
// - 관리자는 학급을 지울 수 있지만 학생 명단·과제 기록·공지 내용은 읽지 못함
service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn() {
      return request.auth != null;
    }
    // 문서 경로: path('admins', uid) → /admins/{uid}, cls(cid, 'pins', sid) → /classes/{cid}/pins/{sid}
    function path(col, id) {
      return /databases/$(db)/documents/$(col)/$(id);
    }
    function cls(cid, col, id) {
      return /databases/$(db)/documents/classes/$(cid)/$(col)/$(id);
    }
    function isAdmin() {
      return signedIn() && exists(path('admins', request.auth.uid));
    }
    function isTeacher(cid) {
      return signedIn() && exists(cls(cid, 'teachers', request.auth.uid));
    }
    // 학생 기기: 등록 문서가 있고, 그 뒤로 교사가 PIN을 초기화하지 않았는지 (PIN 해시가 같은지)
    function memberDoc(cid) {
      return get(cls(cid, 'members', request.auth.uid));
    }
    function isMember(cid) {
      return signedIn()
        && exists(cls(cid, 'members', request.auth.uid))
        && exists(cls(cid, 'pins', memberDoc(cid).data.sid))
        && memberDoc(cid).data.pinHash == get(cls(cid, 'pins', memberDoc(cid).data.sid)).data.pinHash;
    }
    function isStudent(cid, sid) {
      return isMember(cid) && memberDoc(cid).data.sid == sid;
    }
    // TV 화면 기기: 교사가 발급한 비밀 값과 같아야 함 (새 주소를 만들면 예전 TV는 막힘)
    function isScreen(cid) {
      return signedIn()
        && exists(cls(cid, 'screens', request.auth.uid))
        && get(cls(cid, 'screens', request.auth.uid)).data.token == get(cls(cid, 'secrets', 'tv')).data.token;
    }
    function canWipe(cid) {
      return isTeacher(cid) || isAdmin();
    }
    function maxStudents(cid) {
      return get(path('classes', cid)).data.get('maxStudents', 40);
    }
    // 학생 번호: s1 ~ s{정원}
    function validSid(cid, sid) {
      return sid.matches('s[0-9]{1,2}') && int(sid[1:]) >= 1 && int(sid[1:]) <= maxStudents(cid);
    }
    // 학급을 만드는 바로 그 묶음 쓰기인지 (교사 등록과 함께 기본 문서를 만들 때)
    function isNewClassBy(cid) {
      return signedIn()
        && !exists(path('classes', cid))
        && existsAfter(path('classes', cid))
        && getAfter(cls(cid, 'teachers', request.auth.uid)).data.keyHash == getAfter(cls(cid, 'secrets', 'teacher')).data.keyHash;
    }
    function validName(n) {
      return n is string && n.size() >= 1 && n.size() <= 12;
    }

    // ---------- 관리자 ----------
    // config/admin { keyHash } 는 콘솔에서 한 번 만들어 둠. 앱에서는 읽지도 쓰지도 못함
    match /config/{docId} {
      allow read, write: if false;
    }
    match /admins/{uid} {
      allow get, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['keyHash'])
        && request.resource.data.keyHash == get(path('config', 'admin')).data.keyHash;
    }

    // ---------- 개설 코드 ----------
    match /inviteCodes/{code} {
      allow get: if signedIn(); // 코드를 정확히 아는 사람만 (목록은 관리자만)
      allow list, create, delete: if isAdmin();
      allow update: if isAdmin()
        || (signedIn()
            && resource.data.active == true
            && resource.data.usedCount < resource.data.maxClasses
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedCount'])
            && request.resource.data.usedCount == resource.data.usedCount + 1);
    }

    // ---------- 학급 ----------
    match /classes/{cid} {
      // 학급 문서에는 개설 코드가 들어 있어 교사·관리자만 읽음 (학급 이름·정원은 public/roster 에서 읽음)
      allow get: if isTeacher(cid) || isAdmin();
      allow list: if isAdmin();
      // 개설: 유효한 개설 코드가 있어야 하고, 같은 묶음에서 그 코드의 사용 횟수를 1 올리고 이 기기를 교사로 등록해야 함
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['name', 'inviteCode', 'createdAt', 'maxStudents'])
        && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 40
        && request.resource.data.maxStudents is int && request.resource.data.maxStudents >= 1 && request.resource.data.maxStudents <= 40
        && get(path('inviteCodes', request.resource.data.inviteCode)).data.active == true
        && get(path('inviteCodes', request.resource.data.inviteCode)).data.usedCount
           < get(path('inviteCodes', request.resource.data.inviteCode)).data.maxClasses
        && getAfter(path('inviteCodes', request.resource.data.inviteCode)).data.usedCount
           == get(path('inviteCodes', request.resource.data.inviteCode)).data.usedCount + 1
        && existsAfter(cls(cid, 'teachers', request.auth.uid));
      // 교사가 바꿀 수 있는 것: 학급 이름, 정원, 과제·공지 ID 목록(refs: 학급 삭제 때 쓰임)
      allow update: if isTeacher(cid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'maxStudents', 'refs'])
        && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 40
        && request.resource.data.maxStudents is int && request.resource.data.maxStudents >= 1 && request.resource.data.maxStudents <= 40;
      allow delete: if canWipe(cid);

      // secrets/teacher { keyHash, resetHash? }: 교사 비밀번호 해시 (아무도 못 읽음)
      // secrets/reset { codeHash, expiresAt }: 관리자가 발급한 비밀번호 재설정 코드 (아무도 못 읽음)
      // secrets/tv { token }: TV 주소의 비밀 값 (교사만 읽고 바꿈)
      match /secrets/{docId} {
        allow get: if docId == 'tv' && isTeacher(cid);
        allow list: if false;
        allow create: if docId == 'teacher' && signedIn()
          && !exists(path('classes', cid))
          && existsAfter(path('classes', cid))
          && request.resource.data.keys().hasOnly(['keyHash']);
        // 비밀번호 재설정: 재설정 코드를 아는 사람만, 만료 전에, 한 번만
        allow update: if docId == 'teacher' && signedIn()
          && exists(cls(cid, 'secrets', 'reset'))
          && request.resource.data.keys().hasOnly(['keyHash', 'resetHash'])
          && request.resource.data.keyHash is string
          && request.resource.data.resetHash == get(cls(cid, 'secrets', 'reset')).data.codeHash
          && request.time < get(cls(cid, 'secrets', 'reset')).data.expiresAt
          && resource.data.get('resetHash', '') != get(cls(cid, 'secrets', 'reset')).data.codeHash;
        // 재설정 코드 발급(관리자만): 길어야 2일 안에 만료
        allow create, update: if docId == 'reset' && isAdmin()
          && exists(path('classes', cid))
          && request.resource.data.keys().hasOnly(['codeHash', 'expiresAt'])
          && request.resource.data.codeHash is string
          && request.resource.data.expiresAt is timestamp
          && request.resource.data.expiresAt <= request.time + duration.value(2, 'd');
        allow create, update: if docId == 'tv' && (isTeacher(cid) || isNewClassBy(cid))
          && request.resource.data.keys().hasOnly(['token'])
          && request.resource.data.token is string && request.resource.data.token.size() >= 16;
        allow delete: if canWipe(cid);
      }

      // 교사로 등록된 기기: 교사 비밀번호 해시가 맞아야 만들 수 있음
      match /teachers/{uid} {
        allow get: if signedIn() && request.auth.uid == uid;
        allow list: if canWipe(cid);
        allow create, update: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['keyHash'])
          && request.resource.data.keyHash == getAfter(cls(cid, 'secrets', 'teacher')).data.keyHash;
        allow delete: if canWipe(cid) || (signedIn() && request.auth.uid == uid);
      }

      // TV로 등록된 기기: TV 주소의 비밀 값이 맞아야 만들 수 있음
      match /screens/{uid} {
        allow get: if signedIn() && request.auth.uid == uid;
        allow list: if canWipe(cid);
        allow create, update: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['token'])
          && request.resource.data.token == get(cls(cid, 'secrets', 'tv')).data.token;
        allow delete: if canWipe(cid) || (signedIn() && request.auth.uid == uid);
      }

      // 학생 PIN 해시: 빈 번호에 처음 들어올 때 한 번만 만들 수 있고(같은 묶음에서 기기 등록 + 등록 표시), 교사만 지울(초기화) 수 있음
      match /pins/{sid} {
        allow read, update: if false;
        allow create: if signedIn()
          && validSid(cid, sid)
          && request.resource.data.keys().hasOnly(['pinHash'])
          && request.resource.data.pinHash is string
          && getAfter(cls(cid, 'members', request.auth.uid)).data.sid == sid
          && getAfter(cls(cid, 'public', 'roster')).data.claimed[sid] == true;
        allow delete: if canWipe(cid);
      }

      // 학생으로 등록된 기기: PIN 해시가 맞아야 만들 수 있음
      match /members/{uid} {
        allow get: if signedIn() && request.auth.uid == uid;
        allow list: if canWipe(cid);
        allow create, update: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['sid', 'pinHash'])
          && request.resource.data.sid is string
          && request.resource.data.pinHash == getAfter(cls(cid, 'pins', request.resource.data.sid)).data.pinHash;
        allow delete: if canWipe(cid) || (signedIn() && request.auth.uid == uid);
      }

      // 학생 명단 (번호·이름): 본인과 교사만 읽음
      match /students/{sid} {
        allow get: if isTeacher(cid) || isStudent(cid, sid);
        allow list: if isTeacher(cid);
        allow create, update: if isTeacher(cid)
          && validSid(cid, sid)
          && request.resource.data.keys().hasOnly(['number', 'name', 'joined', 'nameAt'])
          && request.resource.data.number == int(sid[1:])
          && validName(request.resource.data.name);
        // 처음 참여: 이름 확인 (교사가 넣어 둔 이름을 그대로 쓰거나 고침)
        allow create: if isStudent(cid, sid)
          && request.resource.data.keys().hasOnly(['number', 'name', 'joined'])
          && request.resource.data.number == int(sid[1:])
          && request.resource.data.joined == true
          && validName(request.resource.data.name);
        allow update: if isStudent(cid, sid)
          && resource.data.get('joined', false) != true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['number', 'name', 'joined'])
          && request.resource.data.number == int(sid[1:])
          && request.resource.data.joined == true
          && validName(request.resource.data.name);
        // 본인이 이름 바꾸기: 30일에 한 번 (바꾼 때는 서버 시계로 기록)
        allow update: if isStudent(cid, sid)
          && resource.data.get('joined', false) == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'nameAt'])
          && validName(request.resource.data.name)
          && request.resource.data.nameAt == request.time
          && (!('nameAt' in resource.data) || request.time > resource.data.nameAt + duration.value(30, 'd'));
        allow delete: if canWipe(cid);
      }

      // 학생 한 명의 기록 { tasks:{과제ID:{state,note,at}}, reads:{공지ID:시각}, last }: 본인과 교사만 읽음
      // 학생은 과제 하나의 상태를 '다 했어요'(done) 또는 '미완료'(todo)로만 바꿀 수 있고, 교사가 '확인'한 과제는 못 바꿈
      match /status/{sid} {
        function studentTaskOk(before) {
          let d = request.resource.data;
          let t = d.last;
          let old = before.get('tasks', {}).get(t, {});
          return t is string
            && d.tasks.diff(before.get('tasks', {})).affectedKeys().hasOnly([t])
            && d.tasks[t].keys().hasOnly(['state', 'at', 'note'])
            && d.tasks[t].state in ['done', 'todo']
            && d.tasks[t].at == request.time
            && d.tasks[t].get('note', '') == old.get('note', '')
            && old.get('state', 'todo') != 'checked';
        }
        function studentWriteOk(before) {
          let changed = request.resource.data.diff(before).affectedKeys();
          return isStudent(cid, sid)
            && request.resource.data.keys().hasOnly(['tasks', 'reads', 'last'])
            && (!('tasks' in changed) || studentTaskOk(before));
        }
        allow get: if isTeacher(cid) || isStudent(cid, sid);
        allow list: if isTeacher(cid);
        allow create: if isTeacher(cid) || studentWriteOk({});
        allow update: if isTeacher(cid) || studentWriteOk(resource.data);
        allow delete: if canWipe(cid);
      }

      // 학급 이름·정원·번호별 등록 여부 { name, maxStudents, claimed:{sid:true} } (학생 이름 없음): 학급 코드를 아는 사람은 읽음 (입장 화면)
      match /public/roster {
        allow get: if signedIn();
        allow create: if isNewClassBy(cid);
        allow update: if isTeacher(cid)
          // 학생이 빈 번호에 처음 들어올 때: 자기 번호 하나만 true 로 (같은 묶음에서 PIN을 처음 만듦)
          || (signedIn()
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimed'])
              && request.resource.data.claimed.diff(resource.data.get('claimed', {})).affectedKeys().hasOnly([getAfter(cls(cid, 'members', request.auth.uid)).data.sid])
              && request.resource.data.claimed[getAfter(cls(cid, 'members', request.auth.uid)).data.sid] == true
              && !exists(cls(cid, 'pins', getAfter(cls(cid, 'members', request.auth.uid)).data.sid))
              && existsAfter(cls(cid, 'pins', getAfter(cls(cid, 'members', request.auth.uid)).data.sid)));
        allow delete: if canWipe(cid);
      }

      // 실시간 문서 ('지금 열기'·공지 목록 요약·과제 요약과 완료 인원수): 학생·TV·교사가 읽음
      // 학생은 자기가 '다 했어요'를 누르거나 되돌릴 때 그 과제의 완료 인원수만 1씩 바꿀 수 있음 (교사 화면이 실제 기록으로 바로잡음)
      match /public/live {
        allow get: if isTeacher(cid) || isMember(cid) || isScreen(cid);
        allow create: if isTeacher(cid) || isNewClassBy(cid);
        allow update: if isTeacher(cid)
          || (isMember(cid)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['done', 'doneLast'])
              && request.resource.data.doneLast is string
              && request.resource.data.doneLast in resource.data.get('tasks', {})
              && request.resource.data.done.diff(resource.data.get('done', {})).affectedKeys().hasOnly([request.resource.data.doneLast])
              && (request.resource.data.done[request.resource.data.doneLast] == resource.data.get('done', {}).get(request.resource.data.doneLast, 0) + 1
                  || request.resource.data.done[request.resource.data.doneLast] == resource.data.get('done', {}).get(request.resource.data.doneLast, 0) - 1));
        allow delete: if canWipe(cid);
      }

      // 링크 모음 { items:{id:링크} }: 학생·교사가 읽고, 교사만 씀
      match /public/links {
        allow get: if isTeacher(cid) || isMember(cid);
        allow create: if isTeacher(cid) || isNewClassBy(cid);
        allow update: if isTeacher(cid);
        allow delete: if canWipe(cid);
      }

      // 과제: 학생·교사가 읽고, 교사만 씀
      match /tasks/{tid} {
        allow read: if isTeacher(cid) || isMember(cid);
        allow create, update: if isTeacher(cid);
        allow delete: if canWipe(cid);
      }

      // 공지(그림 포함): 교사는 모두, 학생은 게시 시각이 지난 것만 읽음
      match /notices/{nid} {
        allow get: if isTeacher(cid) || (isMember(cid) && resource.data.publishAt <= request.time);
        allow list: if isTeacher(cid);
        allow create, update: if isTeacher(cid) && request.resource.data.publishAt is timestamp;
        allow delete: if canWipe(cid);
      }

      // 교사만 쓰는 자료 (과제 템플릿)
      match /private/{docId} {
        allow read, write: if isTeacher(cid);
        allow delete: if canWipe(cid);
      }
    }
  }
}
